<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="1.0dp" />
            <solid android:color="#5ece7127" />
            <stroke android:width="0.70000005dp" android:color="#ff0e0f10" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="1.0dp" />
            <solid android:color="#ff0e0f10" />
            <stroke android:width="0.70000005dp" android:color="#ffffffff" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="1.0dp" />
            <solid android:color="#ff0e0f10" />
            <stroke android:width="0.20000005dp" android:color="#6f797d7e" />
        </shape>
    </item>
</selector>
